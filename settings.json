{
  "workbench.colorTheme": "Visual Studio Light - C++",
  "update.mode": "none",
  "workbench.startupEditor": "none",
  "git.detectSubmodulesLimit": 100,
  "editor.rulers": [],
  "claudeCode.preferredLocation": "panel",
  "claudeCode.useTerminal": true,
  "editor.minimap.enabled": false,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.persistentSessionScrollback": 1000,
  "terminal.integrated.rightClickBehavior": "default",
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.tabs.focusMode": "singleClick",
  "git.inputValidation": true,
  "diffEditor.renderSideBySide": true,
  "diffEditor.experimental.showMoves": true,
  "terminal.integrated.fontSize": 15,
  "cSpell.showInRuler": false,
  "cSpell.useCustomDecorations": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "git-worktree-manager.worktreeSubdirectoryTemplate": "$REF_NAME",
  "scm.defaultViewMode": "tree",
  "scm.repositories.visible": 0,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.renderWhitespace": "all"
}
